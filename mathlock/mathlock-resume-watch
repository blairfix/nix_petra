#!/usr/bin/env bash

# Run once when this script starts at login.
mathlock

dbus-monitor --system \
  "type='signal',sender='org.freedesktop.login1',interface='org.freedesktop.login1.Manager',member='PrepareForSleep'" |
while IFS= read -r line; do
    case "$line" in
        *member=PrepareForSleep*)
            IFS= read -r value || exit
            case "$value" in
                *"boolean false"*)
                    sleep 2
		    /run/current-system/sw/bin/mathlock
                    ;;
            esac
            ;;
    esac
done
